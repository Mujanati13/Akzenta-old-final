<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #f2f4f6;
            color: #2d3748;
            -webkit-font-smoothing: antialiased;
        }

        .wrapper {
            width: 100%;
            padding: 40px 0;
            background-color: #f2f4f6;
        }

        .container {
            max-width: 520px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        }

        .header {
            padding: 28px 32px 18px 32px;
            text-align: center;
            background: linear-gradient(135deg, #00838f 0%, #006064 100%);
        }

        .header-title {
            margin: 0;
            font-size: 22px;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.3px;
        }

        .content {
            padding: 30px 34px 34px 34px;
            text-align: left;
        }

        .text {
            font-size: 15px;
            line-height: 1.6;
            margin: 0 0 10px 0;
            color: #4a5568;
        }

        .btn-wrapper {
            margin: 26px 0 10px 0;
            text-align: center;
        }

        .btn {
            display: inline-block;
            padding: 13px 40px;
            background: linear-gradient(135deg, #00838f 0%, #00acc1 100%);
            color: #ffffff !important;
            text-decoration: none;
            font-size: 15px;
            font-weight: 600;
            border-radius: 8px;
            box-shadow: 0 4px 14px rgba(0, 131, 143, 0.35);
            border: none;
        }

        .footer-text {
            font-size: 13px;
            color: #718096;
            margin-top: 18px;
            line-height: 1.5;
        }
    </style>
</head>

<body>
    <div class="wrapper">
        <div class="container">
            <div class="header">
                <h1 class="header-title">{{app_name}}</h1>
            </div>
            <div class="content">
                <p class="text">{{text1}}</p>
                <p class="text">{{text2}}</p>
                <p class="text">{{text3}}</p>

                <div class="btn-wrapper">
                    <a href="{{url}}" class="btn">{{actionTitle}}</a>
                </div>

                <p class="footer-text">
                    {{text4}}
                </p>
            </div>
        </div>
    </div>
</body>

</html>