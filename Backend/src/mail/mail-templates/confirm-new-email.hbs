<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #f2f4f6;
            color: #2d3748;
            -webkit-font-smoothing: antialiased;
        }

        .wrapper {
            width: 100%;
            padding: 40px 0;
            background-color: #f2f4f6;
        }

        .container {
            max-width: 560px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        }

        .header {
            padding: 28px 32px 18px 32px;
            text-align: center;
            background: linear-gradient(135deg, #00838f 0%, #006064 100%);
        }

        .header-title {
            margin: 0;
            font-size: 24px;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.4px;
        }

        .content {
            padding: 32px 36px 36px 36px;
        }

        .greeting {
            font-size: 18px;
            font-weight: 600;
            margin: 0 0 12px 0;
            color: #1a202c;
        }

        .text {
            font-size: 15px;
            line-height: 1.6;
            margin: 0 0 12px 0;
            color: #4a5568;
        }

        .btn-wrapper {
            margin: 32px 0 10px 0;
            text-align: center;
        }

        .btn {
            display: inline-block;
            padding: 14px 44px;
            background: linear-gradient(135deg, #00838f 0%, #00acc1 100%);
            color: #ffffff !important;
            text-decoration: none;
            font-size: 16px;
            font-weight: 600;
            border-radius: 8px;
            box-shadow: 0 4px 14px rgba(0, 131, 143, 0.35);
            border: none;
        }

        .link {
            display: inline-block;
            margin-top: 8px;
            color: #00838f;
            text-decoration: none;
            word-break: break-all;
            font-weight: 500;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="container">
            <div class="header">
                <h1 class="header-title">{{app_name}}</h1>
            </div>
            <div class="content">
                <p class="greeting">{{text1}}</p>
                <p class="text">{{text2}}</p>
                <p class="text">{{text3}}</p>

                <div class="btn-wrapper">
                    <a href="{{url}}" class="btn">{{actionTitle}}</a>
                </div>

                <a href="{{url}}" class="link">{{url}}</a>
            </div>
        </div>
    </div>
</body>
</html>
