FROM node:22-alpine AS office
WORKDIR /app
ARG MAPBOX_PUBLIC_TOKEN
COPY HeadOffice/package.json HeadOffice/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY HeadOffice/ ./
COPY deployment/configure-maps.cjs /configure-maps.cjs
RUN node /configure-maps.cjs && ./node_modules/.bin/ng build --configuration production

FROM node:22-alpine AS client
WORKDIR /app
ARG MAPBOX_PUBLIC_TOKEN
COPY Client/package.json Client/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY Client/ ./
COPY deployment/configure-maps.cjs /configure-maps.cjs
RUN node /configure-maps.cjs && ./node_modules/.bin/ng build --configuration production

FROM node:22-alpine AS team
WORKDIR /app
ARG MAPBOX_PUBLIC_TOKEN
COPY Merchandiser/package.json Merchandiser/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY Merchandiser/ ./
COPY deployment/configure-maps.cjs /configure-maps.cjs
RUN node /configure-maps.cjs && ./node_modules/.bin/ng build --configuration production

FROM nginx:stable-alpine
COPY --from=office /app/dist/angular-boilerplate/browser /usr/share/nginx/office
COPY --from=client /app/dist/angular-boilerplate/browser /usr/share/nginx/client
COPY --from=team /app/dist/angular-boilerplate/browser /usr/share/nginx/team
COPY deployment/nginx.conf /etc/nginx/nginx.conf
COPY deployment/proxy.conf /etc/nginx/proxy.conf
EXPOSE 8080 8081 8082
